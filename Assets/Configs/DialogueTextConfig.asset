--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8f54657b8e8b48ba9c0030171a625a5c, type: 3}
  m_Name: DialogueTextConfig
  m_EditorClassIdentifier: Assembly-CSharp::DefaultNamespace.DialogueTextConfig
  <Prologue>k__BackingField:
    Dialogue:
    - DialogueText: "\u041A\u043E\u0442\u043E\u0440\u044B\u0439 \u0441\u0435\u0439\u0447\u0430\u0441
        \u0447\u0430\u0441?"
      CurEmote: 0
    - DialogueText: "\u0410 \u0434\u0435\u043D\u044C?!"
      CurEmote: 0
    - DialogueText: "\u041D\u0430\u0447\u0438\u043D\u0430\u044E \u0441\u0430\u043C
        \u0441\u0435\u0431\u044F \u0437\u0430\u0431\u044B\u0432\u0430\u0442\u044C
        \u043E\u0442 \u0442\u043E\u0433\u043E, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u0441\u0438\u0436\u0443 \u0432 \u044D\u0442\u043E\u0439 \u0442\u044E\u0440\u044C\u043C\u0435..."
      CurEmote: 1
    - DialogueText: "*\u0417\u0412\u0423\u041A\u0418 \u041F\u041E\u041B\u041E\u041C\u041A\u0418
        \u0422\u041E\u041B\u0427\u041A\u0410*"
      CurEmote: 1
    - DialogueText: "\u042D\u0442\u043E \u0447\u0442\u043E \u0442\u0430\u043A\u043E\u0435??
        \u041D\u0435\u0443\u0436\u0435\u043B\u0438 \u0435\u0433\u043E \u0441\u043D\u043E\u0432\u0430
        \u043F\u0440\u043E\u0440\u0432\u0430\u043B\u043E? \u041A\u0430\u0436\u0435\u0442\u0441\u044F,
        \u0432 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u0432\u0441\u0435 \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E."
      CurEmote: 2
    - DialogueText: "\u041D\u0430\u0434\u043E \u0443\u0445\u043E\u0434\u0438\u0442\u044C.
        \u042D\u0442\u043E \u043C\u043E\u0439 \u0448\u0430\u043D\u0441. "
      CurEmote: 0
    - DialogueText: "\u0428\u0430\u043D\u0441 \u043D\u0430 \u0421\u0412\u041E\u0411\u041E\u0414\u0423!"
      CurEmote: 0
  <Act1>k__BackingField:
    Dialogue:
    - DialogueText: "\u0412\u0440\u043E\u0434\u0435 \u043E\u0442\u043E\u0440\u0432\u0430\u043B\u0441\u044F..."
      CurEmote: 0
    - DialogueText: "*\u0417\u0412\u0423\u041A\u0418 \u041F\u0420\u0418\u0411\u041B\u0418\u0416\u0410\u042E\u0429\u0415\u0413\u041E\u0421\u042F
        \u0426\u0423\u041D\u0410\u041C\u0418 \u0418\u0417 \u0413\u041E\u0412\u041D\u0410*"
      CurEmote: 0
    - DialogueText: "\u043D\u0435\u0442-\u043D\u0435\u0442-\u043D\u0435\u0442-\u043D\u0435\u0442-\u043D\u0435\u0442-\u043D\u0435\u0442-\u043D\u0435\u0442-\u043D\u0435\u0442-\u043D\u0435\u0442"
      CurEmote: 2
    - DialogueText: "\u041D\u0430\u0434\u043E \u0443\u0445\u043E\u0434\u0438\u0442\u044C..."
      CurEmote: 2
  <Act2>k__BackingField:
    Dialogue:
    - DialogueText: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E! \u042F \u043F\u043E\u0447\u0442\u0438
        \u0432\u044B\u0431\u0440\u0430\u043B\u0441\u044F \u0438\u0437 \u0442\u044E\u0440\u044C\u043C\u044B,
        \u0441\u0432\u043E\u0431\u043E\u0434\u0430 \u0441\u043E\u0432\u0441\u0435\u043C
        \u0431\u043B\u0438\u0437\u043A\u043E. "
      CurEmote: 0
    - DialogueText: "\u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043F\u0440\u043E\u0439\u0442\u0438
        \u0432\u0438\u0442\u0440\u0430\u0436\u043D\u0443\u044E \u0431\u0430\u0448\u043D\u044E,
        \u0434\u0430?"
      CurEmote: 0
    - DialogueText: "*\u0417\u0415\u041C\u041B\u0415\u0422\u0420\u042F\u0421\u0415\u041D\u0418\u0415*"
      CurEmote: 0
    - DialogueText: "\u0410 \u044D\u0442\u043E \u0435\u0449\u0451 \u0447\u0442\u043E?
        \u0417\u0415\u041C\u041B\u0415\u0422\u0420\u042F\u0421\u0415\u041D\u0418\u0415?
        \u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E! \u041F\u0430\u0434\u0430\u044E\u0442
        \u043E\u0441\u043A\u043E\u043B\u043A\u0438 \u0432\u0438\u0442\u0440\u0430\u0436\u0435\u0439!"
      CurEmote: 2
  <Act3>k__BackingField:
    Dialogue:
    - DialogueText: "\u0414\u0430! \u042F \u0432\u044B\u0431\u0440\u0430\u043B\u0441\u044F,
        \u0443 \u043C\u0435\u043D\u044F \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C! "
      CurEmote: 3
    - DialogueText: "\u041D\u043E..."
      CurEmote: 3
    - DialogueText: "\u0418\u0437-\u0437\u0430 \u0422\u0423\u041C\u0410\u041D\u0410
        \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0432\u0438\u0434\u043D\u043E. "
      CurEmote: 1
    - DialogueText: "\u0417\u0430\u0431\u0435\u0440\u0443\u0441\u044C \u043F\u043E\u0432\u044B\u0448\u0435!
        \u042F \u043F\u043E\u0447\u0442\u0438 \u0441\u0432\u043E\u0431\u043E\u0434\u0435\u043D!!"
      CurEmote: 3
  <Finale>k__BackingField:
    Dialogue:
    - DialogueText: ...
      CurEmote: 2
    - DialogueText: "\u041D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C..."
      CurEmote: 2
    - DialogueText: "\u041D\u0435\u0443\u0436\u0435\u043B\u0438?"
      CurEmote: 1
    - DialogueText: ...
      CurEmote: 1
    - DialogueText: ...
      CurEmote: 2
    - DialogueText: "\u042F \u0442\u0430\u043A \u0445\u043E\u0442\u0435\u043B \u0441\u0431\u0435\u0436\u0430\u0442\u044C
        \u0438\u0437 \u0442\u044E\u0440\u044C\u043C\u044B, \u0440\u0432\u0430\u043B\u0441\u044F
        \u043D\u0430 \u0441\u0432\u043E\u0431\u043E\u0434\u0443! "
      CurEmote: 2
    - DialogueText: "\u042D\u0442\u043E \u0438 \u0435\u0441\u0442\u044C \u043C\u043E\u044F
        \u0441\u0432\u043E\u0431\u043E\u0434\u0430???"
      CurEmote: 2
    - DialogueText: "\u041F\u0440\u043E\u0441\u0442\u043E.... \"\u041A\u043B\u0435\u0442\u043A\u0430\"..
        \u043F\u043E\u0431\u043E\u043B\u044C\u0448\u0435?..."
      CurEmote: 1
    - DialogueText: "\u0427\u0435\u0440\u0442\u043E\u0432\u0430 \u043C\u0435\u0433\u0430\u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0430..."
      CurEmote: 1
