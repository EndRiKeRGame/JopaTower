  <Prologue>k__BackingField:
    Dialogue:
    - DialogueText: "\u041F\u0440\u0438\u0432\u0435\u0442, \u044F \u0442\u0435\u0441\u0442\u043E\u0432\u044B\u0439
        \u0434\u0438\u0430\u043B\u043E\u0433"
      CurEmote: 0
    - DialogueText: "\u041D\u0435 \u043F\u0443\u0433\u0430\u0439\u0441\u044F, \u044F
        \u043D\u0435 \u043A\u0443\u0441\u0430\u044E\u0441\u044C"
      CurEmote: 2
    - DialogueText: "\u041F\u0440\u043E\u0441\u0442\u0438, \u0435\u0441\u043B\u0438
        \u043D\u0430\u043F\u0443\u0433\u0430\u043B"
      CurEmote: 1
    - DialogueText: "\u041D\u0430\u0434\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
        \u0432\u0441\u0435 \u0441\u043F\u0440\u0430\u0439\u0442\u044B \u0438 \u043F\u0435\u0440\u0435\u0445\u043E\u0434
        \u0432 \u0434\u0438\u0430\u043B\u043E\u0433\u0430\u0445"
      CurEmote: 3
  <Act1>k__BackingField:
    Dialogue:
    - DialogueText: "\u0422\u0435\u0441\u0442 1"
      CurEmote: 0
    - DialogueText: "\u0422\u0435\u0441\u0442 2"
